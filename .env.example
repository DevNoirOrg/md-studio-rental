# Resend (foglalási értesítő e-mailek)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BOOKING_NOTIFICATION_EMAIL=

# Supabase (közös projekt; a táblák a `rental` sémában — Data API → Exposed schemas: rental)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Az admin e-mailes belépéséhez és a terem képekhez (Storage „rental” bucket) — ugyanaz a projekt címe, mint a SUPABASE_URL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A kanonikus domain (csak a domain, útvonal nélkül!) — az e-mailek jóváhagyó linkjei
# <APP_BASE_URL>/studio-berles/booking-review címre mutatnak. Élesben: https://www.hiphoptanciskola.com
APP_BASE_URL=http://localhost:3000
# A kanonikus (Google által indexelt) domain; alapból https://www.hiphoptanciskola.com
NEXT_PUBLIC_CANONICAL_ORIGIN=

# Admin felület (/admin): e-mailes kóddal lehet belépni; az adminok a rental.admins táblában vannak.
# (A korábbi ADMIN_USERNAME / ADMIN_PASSWORD / ADMIN_SESSION_SECRET már nem kell — törölhető.)

# Az MD Dance School oldal címe (fejléc/lábléc „vissza” linkje)
NEXT_PUBLIC_SCHOOL_URL=https://www.hiphoptanciskola.com

# Google Naptár szinkron (opcionális; lásd GOOGLE-NAPTAR.md). CSAK szerveroldali titok — ne legyen NEXT_PUBLIC_ előtag!
# A szolgáltatásfiók letöltött JSON kulcsa, egy sorban (a teljes fájltartalom)
GOOGLE_SERVICE_ACCOUNT_JSON=
# A közös foglalási naptár azonosítója (minden terem ebbe kerül, termenként más színnel).
# A fiók fő naptáránál maga a Gmail-cím, pl. info.mddancestudio@gmail.com
GOOGLE_CALENDAR_ID=

# Online fizetés (Stripe) — lásd FIZETES.md. CSAK szerveroldali titkok — ne legyen NEXT_PUBLIC_ előtag!
# Teszthez sk_test_…, élesben sk_live_… kulcs. A webhook végpont: <APP_BASE_URL>/studio-berles/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# (opcionális) a fizetési linkek aláíró kulcsa; alapból a STRIPE_SECRET_KEY-ből képződik
PAYMENT_LINK_SECRET=

# Számlázás (Billingo API v3) — a számlatömböt és az ÁFA-t az admin → Fizetés és e-mailek oldalon kell kiválasztani
BILLINGO_API_KEY=

# Az ügyfél-e-mailekre adott válasz címe (alapból info.mddancestudio@gmail.com)
STUDIO_REPLY_TO_EMAIL=

# (opcionális) a Vercel Cron hívás védelme (/studio-berles/api/cron/payments)
CRON_SECRET=
